# Частина 1: перші команди HBase Shell (таблиця замовлень інтернет-магазину).
# На занятті команди набираються вручну в ./demo.sh shell; цей файл — те саме одним прогоном:
#   ./demo.sh shell-file 1_1_orders.hbase
version
status
status 'simple'

# 1.3 Створення таблиці: три Column Family, колонки не оголошуються
create 'orders', 'info', 'items', 'status'
list
describe 'orders'
exists 'orders'

# 1.4 Додавання даних
put 'orders', 'order_001', 'info:customer_id', 'cust_100'
put 'orders', 'order_001', 'info:total', '5990'
put 'orders', 'order_001', 'info:created_at', '2026-04-01'
put 'orders', 'order_001', 'items:item_1', 'Ноутбук ASUS'
put 'orders', 'order_001', 'items:item_2', 'Миша Logitech'
put 'orders', 'order_001', 'status:current', 'new'

put 'orders', 'order_002', 'info:customer_id', 'cust_200'
put 'orders', 'order_002', 'info:total', '1200'
put 'orders', 'order_002', 'info:created_at', '2026-04-02'
put 'orders', 'order_002', 'items:item_1', 'Клавіатура'
put 'orders', 'order_002', 'status:current', 'shipped'

put 'orders', 'order_003', 'info:customer_id', 'cust_100'
put 'orders', 'order_003', 'info:total', '350'
put 'orders', 'order_003', 'info:created_at', '2026-04-03'
put 'orders', 'order_003', 'items:item_1', 'Килимок для миші'
put 'orders', 'order_003', 'status:current', 'delivered'

# 1.5 Читання
get 'orders', 'order_001'
get 'orders', 'order_001', 'info:total'
get 'orders', 'order_001', {COLUMNS => ['info:customer_id', 'status:current']}
scan 'orders'
scan 'orders', {LIMIT => 2}
scan 'orders', {COLUMNS => 'info:total'}

# Кирилиця за замовчуванням друкується як \xD0\x9D... — просимо показати рядком
scan 'orders', {COLUMNS => 'items', FORMATTER => 'toString'}
get 'orders', 'order_001', 'items:item_1:toString'

# 1.6 Видалення
delete 'orders', 'order_003', 'status:current'
get 'orders', 'order_003'
deleteall 'orders', 'order_003'
scan 'orders'

# Бонус: видалене фізично ще на диску — RAW-скан показує tombstone-маркери
scan 'orders', {RAW => true, VERSIONS => 10, STARTROW => 'order_003'}
