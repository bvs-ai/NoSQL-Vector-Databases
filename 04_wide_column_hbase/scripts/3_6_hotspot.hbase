# Бонус до частини 3: три таблиці, заздалегідь розбиті (pre-split) на 4 регіони.
# Межі '1', '2', '3' → регіони ['', '1') ['1', '2') ['2', '3') ['3', '').
# Запуск: ./demo.sh hotspot (створює таблиці, пише логи, показує регіони) або ./demo.sh step 3.6
# перестворюємо з нуля: видаляємо, лише якщо таблиця вже є (тоді файл можна запускати повторно)
%w[hot_ts hot_server hot_salted].each { |t| (disable t; drop t) if exists(t) }
create 'hot_ts',     'log', SPLITS => ['1', '2', '3']
create 'hot_server', 'log', SPLITS => ['1', '2', '3']
create 'hot_salted', 'log', SPLITS => ['1', '2', '3']
